# Copy to backend/.env and change what you need. All settings are optional.
PD_DATABASE_URL=sqlite:///./data/prices.db
# The demo's own database: `price-diaries demo` writes here, never to the one above
PD_DEMO_DATABASE_URL=sqlite:///./data/demo.db
# Daily check time (24h, your computer's local time)
PD_CHECK_HOUR=9
PD_CHECK_MINUTE=17
# Seconds to wait between two pages of the same store
PD_MIN_DELAY=3
PD_MAX_DELAY=7
# Use a headless browser when the price isn't in the page HTML
PD_BROWSER_FALLBACK=true
# Track the loyalty-card price (e.g. Gratis Gold & Platinum) when a store shows one
PD_USE_MEMBER_PRICES=true
# Desktop notifications for new notes while the app runs (the inbox always gets them)
PD_DESKTOP_NOTIFICATIONS=true
